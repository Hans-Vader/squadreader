# Copy this file to .env, then set TWO things: uncomment exactly ONE mode block,
# and set SQUAD_DATA further down. Both are required and neither has a default.
#
#     cp .env.example .env
#
# This stack runs the READER ONLY — it never starts a game server. Yours already
# exists, either in a container you run or natively on the host, and the mode
# says which. Both modes use the same capabilities; only the PID namespace and
# the AppArmor profile differ, because those are the only two things the kernel
# decides differently depending on where the game process lives.

# ── Mode 1 · attach to a Squad container you already run ─────────────────────
# Use the container's NAME (docker ps), not a compose service name — this file
# does not define one.
# SQUAD_PID_MODE=container:my-squad
# SQUAD_APPARMOR=docker-default

# ── Mode 2 · Squad runs natively on the host (LinuxGSM, bare metal) ──────────
# apparmor=unconfined is not optional here: docker-default allows ptrace only
# toward peers under the same profile, so an unconfined host process is refused
# at /proc/<pid>/maps before the reader ever reaches the memory. Note this also
# grants the reader ptrace over every host process — see the README.
# SQUAD_PID_MODE=host
# SQUAD_APPARMOR=unconfined

# ─────────────────────────────────────────────────────────────────────────────

# Your Squad install root, as the DOCKER HOST sees it — the directory that
# CONTAINS SquadGame/. Mounted read-only at /squad in the reader, which reads
# exactly one file under it and writes nothing:
#   <SQUAD_DATA>/SquadGame/Saved/Logs/SquadGame.log
# Required: nothing here creates a Squad install, so there is no sensible
# default. Point it at the server you already run.
# SQUAD_DATA=/home/steam/squad-dedicated

# Replay UI. Loopback by default; put it behind a reverse proxy — either the
# optional one at the end of this file or the nginx config in deploy/ —
# rather than setting SQREADER_BIND=0.0.0.0 on a public box.
SQREADER_BIND=127.0.0.1
SQREADER_PORT=8080

# Optional sqreader.config.json (plugins, alert webhook, central URL). Mount it
# by uncommenting the matching volume line in docker-compose.yml; it is picked
# up from the working directory automatically. Set this only if you mount it
# somewhere other than /app/sqreader.config.json.
# SQREADER_CONFIG=/app/sqreader.config.json

# Reader
SERVER_ID=squad
SQREADER_HZ=0.5
# RECORD_HZ=4          # two-tier recording: 4 Hz position frames between snapshots
# SQREADER_LOG_LEVEL=DEBUG

# Recording retention — a logrotate for replays. RETENTION_INTERVAL=0 turns the
# pruner off entirely; each policy below is disabled on its own with 0.
RETENTION_INTERVAL=86400
RETENTION_MAX_AGE_DAYS=90
RETENTION_MAX_TOTAL_GB=150
RETENTION_MIN_FREE_GB=50
RETENTION_MIN_KEEP=3

# ─────────────────────────────────────────────────────────────────────────────
# Everything above configures the reader itself. Below is an OPTIONAL add-on
# that only exists if you ask for it on the command line.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional reverse proxy with Let's Encrypt (docker-compose.proxy.yml) ─────
#     docker compose -f docker-compose.yml -f docker-compose.proxy.yml up -d
# Without the second -f, nothing below matters. Uncomment exactly one mode.
# Tired of the two -f flags? Set COMPOSE_FILE to both paths, joined by a colon,
# and plain `docker compose` picks them up — it also avoids the orphan-container
# warning you get when a later command leaves the proxy file off.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Mode A · own hostname, certificate obtained and renewed automatically. Needs
# an A/AAAA record pointing here. Open 80 AND 443: Caddy issues over HTTP-01
# (80) or TLS-ALPN-01 (443), and 80 also carries the HTTP->HTTPS redirect.
# SQREADER_SITE=replays.example.com

# Mode B · plain HTTP, no certificate, for TLS terminated ELSEWHERE — a load
# balancer or a webserver on another machine. If the webserver is on THIS host,
# you want no proxy container at all; see the README.
# Uncomment all three lines together: nothing listens on 443 in this mode, but
# the port mapping still claims it and collides with whatever owns it.
# SQREADER_SITE=:80
# PROXY_HTTP_PORT=8081
# PROXY_HTTPS_PORT=8443

# Optional ACME account e-mail. Set it only together with uncommenting the
# `tls` line in deploy/Caddyfile; an empty value stops Caddy from starting.
# LETSENCRYPT_EMAIL=ops@example.com

# Still setting the domain up? Uncomment the staging-CA block at the top of
# deploy/Caddyfile — Let's Encrypt allows 5 failed validations per hour.
